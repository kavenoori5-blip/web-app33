{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app33",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "3ee2089e-6a18-4569-b33a-e2c0f687be38","database_name": "New" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "7febcf9acd40473891590a2a2206169c" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
